499   0354              ; Subrotina de limpeza da area de memoria para o display
500   0354              ;
501   0354              isys_clean_ram_disp:            ; Inicializa area de memoria do display
502   0354 E5               PUSH HL                     ; Reserva HL
503   0355 C5               PUSH BC                     ; Reserva BC
504   0356 21 70 27         LD HL,RAM_DISPLAY           ; Inicio da RAM para display
505   0359 06 06            LD B,06                     ; Preparar ponteiro para 6 endereços a partir do inicio da RAM para display
506   035B              .loop_clean_disp:               ; Inicializa area de memoria do display, com FFH (nenhum segmento aceso)
507   035B 36 FF            LD (HL),0FFH                ; Limpa a exibição no display escrevendo 0FFH na posição de memória
508   035D 23               INC HL                      ; Coloca o ponteiro na próxima posição de memória
509   035E 10 FB            DJNZ .loop_clean_disp       ; Decrementa o reg. B e, se não for zero, continua o loop de limpeza da memória
510   0360 C1               POP BC                      ; Retoma valor reservado de BC
511   0361 E1               POP HL                      ; Retoma valor reservado de HL
512   0362 C9               RET
513   0363 00               DB 00H
514   0364
515   0364              ; Subrotina de exibição de dados no campo de dados (isys_disp_data)
516   0364              ; HL (e HL+1) = posição de memória onde está o dado a ser exibido
517   0364              isys_disp_data:
518   0364 C5               PUSH BC                     ; Reserva o valor de BC (C é usado na subrotina _sys_mem_conv2nibbles)
519   0365 D5               PUSH DE                     ; Reserva o valor de DE
520   0366 11 75 27         LD DE,RAM_DISPLAY+5         ; Coloca o ponteiro DE no 4.o display da esq. para a direita
521   0369 CD 8B 03         CALL _sys_mem_conv2nibbles  ; Chama função que converte os dois nibbles (LSB) do dado apontado por HL em caracteres para o display
522   036C D1               POP DE                      ; Retoma valor reservado de DE
523   036D C1               POP BC                      ; Retoma valor reservado de BC
524   036E CD C2 04         CALL isys_keyb_disp         ; Exibe no display o valor do endereço
525   0371 C9               RET
526   0372 00               DB 00H
527   0373
528   0373              ; Subrotina de exibição de dados no campo de endereço (isys_disp_addr)
529   0373              ; HL (e HL+1) = posição de memória onde está o dado a ser exibido
530   0373              isys_disp_addr:
531   0373 E5               PUSH HL
532   0374 C5               PUSH BC                     ; Reserva o valor de BC (C é usado na subrotina _sys_mem_conv2nibbles)
533   0375 D5               PUSH DE                     ; Reserva o valor de DE
534   0376 11 73 27         LD DE,RAM_DISPLAY+3         ; Coloca o ponteiro DE no 4.o display da esq. para a direita
535   0379 CD 8B 03         CALL _sys_mem_conv2nibbles  ; Chama função que converte os dois nibbles (LSB) do dado apontado por HL em caracteres para o display
536   037C 23               INC HL                      ; Coloca ponteiro HL na próxima posição da variável de dado
537   037D 11 71 27         LD DE,RAM_DISPLAY+1         ; Coloca o ponteiro DE no 2.o display da esq. para a direita
538   0380 CD 8B 03         CALL _sys_mem_conv2nibbles  ; Chama função que converte os dois nibbles (MSB) do dado apontado por HL em caracteres para o display
539   0383 D1               POP DE                      ; Retoma valor reservado de DE
540   0384 C1               POP BC                      ; Retoma valor reservado de BC
541   0385 CD C2 04         CALL isys_keyb_disp         ; Exibe no display o valor do endereço
542   0388 E1               POP HL
543   0389 C9               RET
544   038A 00               DB 00H

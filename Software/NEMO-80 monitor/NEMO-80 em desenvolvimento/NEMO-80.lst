446   02EE 32 FE 25         LD (VAR_CURR_ADDRL),A
447   02F1 32 FF 25         LD (VAR_CURR_ADDRH),A
448   02F4 21 FE 25         LD HL,VAR_CURR_ADDRL        ; Carrega como ponteiro, o endereço da variável da posição de memória a ler/alterar
449   02F7 CD 0C 04         CALL isys_in_addr           ; Chama a rotina de entrada de valor do endereço
450   02FA              menu_wait_keypress:
451   02FA CD A4 03         CALL isys_wait_keypress     ; Depois da entrada do endereço, aguarda tecla DAT para entrada de dados ser pressionada ou outra para sair
452   02FD CB BF            RES 7,A                     ; Reseta o bit de tecla pressionada do reg. A
453   02FF FE 11            CP KEY_DAT                  ; Se pressionada tecla DAT, vai para rotina de entrada de dado
454   0301 28 36            JR Z, menu_addr_data
455   0303 FE 12            CP KEY_MINUS                ; Se pressionada tecla "-", vai para rotina de decremento do endereço exibido
456   0305 28 02            JR Z, menu_addr_minus
457   0307 18 0F            JR menu_addr_isplus         ; Se a tecla pressionada não foi "-", verifica se foi pressionado "+"
458   0309              menu_addr_minus:                ; Rotina de decremento do endereço exibido
459   0309 2A FE 25         LD HL,(VAR_CURR_ADDRL)      ; Carrega o valor armazenado na variável do endereço exibido
460   030C 2B               DEC HL                      ; Decrementa o valor do endereço exibido usando HL
461   030D 22 FE 25         LD (VAR_CURR_ADDRL),HL      ; Escreve o valor decrementado na váriavel de endereço exibido
462   0310 CD B0 03         CALL isys_wait_keyrelease   ; Aguarda o usuário soltar a tecla "-" pressionada
463   0313 21 FE 25         LD HL,VAR_CURR_ADDRL        ; Carrega como ponteiro, o endereço da variável da posição de memória a ler/alterar
464   0316 18 21            JR menu_addr_data           ; Vai para a rotina de entrada de dado dentro do endereço exibido
465   0318              menu_addr_isplus:
466   0318 FE 13            CP KEY_PLUS                 ; Se pressionada tecla "+", vai para rotina de incremento do endereço exibido
467   031A 28 02            JR Z, menu_addr_plus
468   031C 18 0F            JR menu_addr_isgo           ; Se a tecla pressionada não foi "-", verifica se foi pressionado "GO"
469   031E              menu_addr_plus:                 ; Rotina de incremento do endereço obtido
470   031E 2A FE 25         LD HL,(VAR_CURR_ADDRL)      ; Carrega o valor armazenado na variável do endereço exibido
471   0321 23               INC HL                      ; Incrementa o valor do endereço exibido usando HL
472   0322 22 FE 25         LD (VAR_CURR_ADDRL),HL      ; Escreve o valor incrementado na váriavel de endereço exibido
473   0325 CD B0 03         CALL isys_wait_keyrelease   ; Aguarda o usuário soltar a tecla "+" pressionada
474   0328 21 FE 25         LD HL,VAR_CURR_ADDRL        ; Carrega como ponteiro, o endereço da variável da posição de memória a ler/alterar
475   032B 18 0C            JR menu_addr_data           ; Vai para a rotina de entrada de dado dentro do endereço exibido
476   032D              menu_addr_isgo:
477   032D FE 14            CP KEY_GO                   ; Se pressionada tecla "GO", chama execução no endereço atual
478   032F 28 02            JR Z, menu_addr_go
479   0331 18 04            JR menu_addr_otherkey       ; Se a tecla pressionada não foi nenhuma das anteriores, sai do menu de endereço e volta para o menu inicial
480   0333              menu_addr_go:                   ; Rotina da tecla "GO" de execução do programa a partir do endereço exibido
481   0333 2A FE 25         LD HL,(VAR_CURR_ADDRL)      ; Carrega o endereço exibido em HL para execução
482   0336 E9               JP HL                       ; Salta a execução para o endereço exibido
483   0337              menu_addr_otherkey:
484   0337 18 17            JR menu_addr_end            ; Se outra tecla foi pressionada, que não seja "DAT", "+", "-" ou "GO", finaliza a entrada de endereço
485   0339              menu_addr_data:
486   0339 21 FE 25         LD HL,VAR_CURR_ADDRL        ; Carrega como ponteiro, o endereço da variável da posição de memória a ler/alterar
487   033C CD 73 03         CALL isys_disp_addr         ; Exibe o endereço/posição de memória carregado
488   033F 2A FE 25         LD HL,(VAR_CURR_ADDRL)      ; Carrega o endereço exibido para referenciar com o dado nele existente
489   0342 CD 64 03         CALL isys_disp_data         ; Exibe o dado contido no endereço exibido
490   0345 CD B0 03         CALL isys_wait_keyrelease   ; Aguarda o usuário soltar a tecla "DAT" pressionada
491   0348 CD A4 03         CALL isys_wait_keypress     ; Aguarda o usuário pressionar alguma tecla para iniciar o processo de entrada de novo dado ou sair do menu
492   034B CD BC 03         CALL isys_in_data           ; Processa a entrada de dado para o endereço exibido
493   034E 18 AA            JR menu_wait_keypress       ; Quando finalizada a entrada, volta para o inicio do menu de endereço para testar próxima tecla pressionada
494   0350              menu_addr_end:
495   0350 3E FF            LD A,0FFH                   ; Carrega FFH em A, para escapar de próximas condições de tecla pressionada do menu principal
496   0352 C9               RET                         ; Volta para o menu principal
497   0353 00               DB 00H

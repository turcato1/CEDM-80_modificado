441   02E6              menu_addr:
442   02E6 CD 54 03         CALL isys_clean_ram_disp    ; Limpa a memória do display
443   02E9 CD B0 03         CALL isys_wait_keyrelease   ; Aguarda a tecla ADR ser solta
444   02EC              menu_addr_in:

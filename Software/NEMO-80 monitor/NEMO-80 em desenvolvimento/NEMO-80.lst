546   038B              ; Subrotina auxiliar das subrotinas de exibição no display
547   038B              ; Converte 2 nibbles de uma posição de memória em 2 bytes para exibição no display
548   038B              ; HL - Posição de entrada do dado a ser separado em nibbles
549   038B              ; DE - Posição mais alta para escrita dos dados convertidos para display
550   038B              _sys_mem_conv2nibbles
551   038B 7E               LD A,(HL)                   ; Lê o valor contido na posição de memória apontada por HL
552   038C E6 0F            AND 0FH                     ; Filtra apenas a parte menos signicativa
553   038E CD 7B 04         CALL isys_conv_hexdisp      ; Converte a parte filtrada de hexa para o código de exibição no display
554   0391 79               LD A,C                      ; O código de exibição é devolvido em C. Transfere-o para A.
555   0392 12               LD (DE),A                   ; Carrega o valor convertido para o display na posição apontada por DE
556   0393 1B               DEC DE
557   0394 7E               LD A,(HL)
558   0395 CB 3F            SRL A
559   0397 CB 3F            SRL A

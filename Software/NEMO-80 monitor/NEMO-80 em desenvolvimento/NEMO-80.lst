570   03A4              isys_wait_keypress
571   03A4 CD C2 04         CALL isys_keyb_disp         ; Exibe display e lê teclado
572   03A7 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Lê a memória de tecla lida

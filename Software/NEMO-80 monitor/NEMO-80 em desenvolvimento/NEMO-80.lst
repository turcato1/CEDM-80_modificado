228   0137              ; Início da implementação das subrotinas
229   0137
230   0137              ; Subrotina de edição/exibição dos valores dos registradores
231   0137              imenu_reg:
232   0137 F5               PUSH AF                     ; Reserva AF na pilha para poder extrair o valor de F
233   0138 ED 73 FA 25      LD (VAR_REG_SPL),SP         ; Guarda o valor de todos os registradores em posições de memória
234   013C 32 F0 25         LD (VAR_REG_A),A
235   013F 78               LD A,B
236   0140 32 F1 25         LD (VAR_REG_B),A
237   0143 79               LD A,C
238   0144 32 F2 25         LD (VAR_REG_C),A
239   0147 7A               LD A,D
240   0148 32 F3 25         LD (VAR_REG_D),A
241   014B 7B               LD A,E
242   014C 32 F4 25         LD (VAR_REG_E),A
243   014F 7C               LD A,H
244   0150 32 F6 25         LD (VAR_REG_H),A
245   0153 7D               LD A,L
246   0154 32 F7 25         LD (VAR_REG_L),A
247   0157 ED 57            LD A,I
248   0159 32 F8 25         LD (VAR_REG_I),A
249   015C ED 5F            LD A,R
250   015E 32 F9 25         LD (VAR_REG_R),A
251   0161 2A FA 25         LD HL,(VAR_REG_SPL)         ; Extração do valor de F: ao empurrar AF para a pilha, o valor F fica na memória na posição de SP
252   0164 7E               LD A,(HL)                   ; Extrai o valor da posição na pilha
253   0165 32 F5 25         LD (VAR_REG_F),A            ; Guarda o valor de F na memória
254   0168 F1               POP AF
255   0169 CD B0 03         CALL isys_wait_keyrelease   ; Aguarda o usuário soltar o botão REG
256   016C CD 54 03         CALL isys_clean_ram_disp    ; Limpa a exibição no display
257   016F 3E 00            LD A,00H                    ; Zera a posição de memória DRAFT2, que será usada de rascunho
258   0171 32 69 27         LD (RAM_DRAFT2),A
259   0174              .imenu_reg_a:
260   0174 3E B7            LD A,CHR_EQUAL              ; Coloca um caracter de "=" no DISPLAY+3
261   0176 32 73 27         LD (RAM_DISPLAY+3),A
262   0179 3A 69 27         LD A,(RAM_DRAFT2)           ; RAM_DRAFT2 contém qual o item atualmente exibido no menu dos registradores 00 = Reg. A ~ 0A = SP.
263   017C FE 00            CP 00H
264   017E 20 0B            JR NZ,.imenu_reg_b          ; Se o item atual a exibir não for A, segue para testar se é B
265   0180 0E 88            LD C,CHR_A                  ; Carrega o código do caracter "A" em C para exibição no display
266   0182 21 F0 25         LD HL,VAR_REG_A             ; Carrega em HL o endereço onde está o valor salvo do acumulador (A)
267   0185 32 69 27         LD (RAM_DRAFT2),A           ; Salva em RAM_DRAFT2, o acumul. que contém o item atualmente exibido no menu dos registradores 00 = Reg. A ~ 0A = SP.
268   0188 C3 24 02         JP .imenu_reg_dispin        ; Salta para rotina de exibição ou alteração do valor do registrador
269   018B              .imenu_reg_b:

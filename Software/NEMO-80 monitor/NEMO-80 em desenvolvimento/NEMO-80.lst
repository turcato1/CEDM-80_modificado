136   0000              ;******** Início do programa monitor ********
137   0000                  ORG ROMBEGIN
138   0000 C3 68 00         JP main                     ; Salta pontos de entrada de interrupção e vai para o programa principal
139   0003
140   0003              ; Pontos de entrada de interrupções
141   0003 FF FF FF...      BLOCK 0038H-$, 0FFH
142   0038                  ORG 0038H
143   0038 00               NOP                         ; Espaço para tratamento de interrupções (não implementado)
144   0039
145   0039 FF FF FF...      BLOCK 0066H-$, 0FFH
146   0066                  ORG 0066H
147   0066 00               NOP                         ; Espaço para tratamento de interrupções (não implementado)
148   0067
149   0067 76               HALT                        ; HALT para segurança, caso a execução da interrupção possa vazar
150   0068
151   0068              ; ********************** Programa principal **********************
152   0068              main:
153   0068              ; Ajustes e configuração iniciais
154   0068 31 FF 27         LD SP,RAM_STACK_127         ; Ajusta o stack pointer (pilha de dados) no fim da memória RAM. Considerado 128 bytes de stack 2780 até 27FF
155   006B
156   006B              ; Inicializações antes do programa
157   006B              initialization:
158   006B CD 54 03         CALL isys_clean_ram_disp    ; Limpa a memória de exibição no display
159   006E
160   006E              ; Inicio do programa
161   006E              ini_program:
162   006E 3E C8            LD A,CHR_N                  ; Mensagem de inicialização NEMO-80
163   0070 32 70 27         LD (RAM_DISPLAY),A
164   0073 3E 86            LD A,CHR_E
165   0075 32 71 27         LD (RAM_DISPLAY+1),A
166   0078 3E AA            LD A,CHR_M
167   007A 32 72 27         LD (RAM_DISPLAY+2),A
168   007D 3E C0            LD A,CHR_O
169   007F 32 73 27         LD (RAM_DISPLAY+3),A
170   0082 3E 80            LD A,CHR_8
171   0084 32 74 27         LD (RAM_DISPLAY+4),A
172   0087 3E C0            LD A,CHR_0
173   0089 32 75 27         LD (RAM_DISPLAY+5),A
174   008C
175   008C              loop_main_menu:                 ; Rotina de menu inicial
176   008C CD C2 04         CALL isys_keyb_disp
177   008F 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Lê memória de tecla pressionada
178   0092 CB BF            RES 7,A                     ; Reseta o bit indicador de tecla pressionada
179   0094 FE 10            CP 10H                      ; Se pressionada tecla ADR, chama entrada de endereço
180   0096 CC E6 02         CALL Z, menu_addr
181   0099 FE 15            CP 15H                      ; Se pressionada tecla REG, chama menu de registradores
182   009B CC 37 01         CALL Z, imenu_reg
183   009E 18 EC            JR loop_main_menu
184   00A0
185   00A0 FF FF FF...      BLOCK 0100H-$, 0FFH
186   0100                  ORG 0100H
187   0100              ;
188   0100              ; ********************** Subroutinas **********************
189   0100              ;
190   0100              ; Vetores padronizados para chamada de interrupção
191   0100
192   0100              ; Chamadas de sistema (sys) acessiveis ao usuário

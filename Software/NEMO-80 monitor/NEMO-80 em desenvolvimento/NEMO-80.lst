 93   0000              ; Endereços de I/O (I/O ports)
 94   0000              DISP            EQU 01H
 95   0000              SEL_DISP        EQU 03H
 96   0000              KEYB            EQU 01H
 97   0000
 98   0000              ; Constantes indicativas de endereços de memória
 99   0000              ;
100   0000              ; RESERVADO PARA SISTEMA: END. 2600H ~ 27FF
101   0000
102   0000              ; RAM para sistema até 27FF
103   0000              RAM_SYS_START   EQU (RAMBEGIN + 600H) ; 2600H Inicio da área de RAM reservada para sistema
104   0000
105   0000              RAM_DRAFT1      EQU (RAMBEGIN + 768H) ; 2768H Área de rascunho para as subrotinas
106   0000              RAM_DRAFT2      EQU (RAMBEGIN + 769H) ; 2769H Área de rascunho para as subrotinas
107   0000              RAM_DRAFT3      EQU (RAMBEGIN + 76AH) ; 276AH Área de rascunho para as subrotinas
108   0000              RAM_DRAFT4      EQU (RAMBEGIN + 76BH) ; 276BH Área de rascunho para as subrotinas
109   0000              RAM_DRAFT5      EQU (RAMBEGIN + 76CH) ; 276CH Área de rascunho para as subrotinas
110   0000              RAM_KEYB_CONV   EQU (RAMBEGIN + 76DH) ; 276DH Código da tecla pressionada já decodificado de 00H a 17H (24 teclas)
111   0000              RAM_KEYBOARD    EQU (RAMBEGIN + 76EH) ; 276EH Valor binário na matriz da tecla pressionada
112   0000              RAM_KEYB_COL    EQU (RAMBEGIN + 76FH) ; 276FH Coluna selecionada na varredura do teclado
113   0000              RAM_DISPLAY     EQU (RAMBEGIN + 770H) ; 2770H Caracteres a serem exibidos no display pos. 2770H a 2775H
114   0000
115   0000              ; Stack (pilha de dados) = 2780H a 27FFH
116   0000              RAM_STACK_0     EQU (RAMBEGIN + 780H) ; 2780H
117   0000              RAM_STACK_127   EQU (RAMBEGIN + 7FFH) ; 27FFH
118   0000
119   0000              ; Variáveis do programa, do endereço 25FF para trás (128 bytes)
120   0000              VAR_REG_A       EQU (RAMBEGIN + 5F0H) ; 25F0H
121   0000              VAR_REG_B       EQU (RAMBEGIN + 5F1H) ; 25F1H
122   0000              VAR_REG_C       EQU (RAMBEGIN + 5F2H) ; 25F2H

271   018D 20 0B            JR NZ,.imenu_reg_c          ; Se o item atual a exibir não for B, segue para testar se é C
272   018F 0E 83            LD C,CHR_B                  ; Carrega o código do caracter "B" em C para exibição no display
273   0191 21 F1 25         LD HL,VAR_REG_B             ; Carrega em HL o endereço onde está o valor salvo do registrador B
274   0194 32 69 27         LD (RAM_DRAFT2),A           ; Salva em RAM_DRAFT2, o acumul. que contém o item atualmente exibido no menu dos registradores 00 = Reg. A ~ 0A = SP.

578   03B0              ; Subrotina para aguardar em loop uma tecla ser solta
579   03B0              ; A : Código da tecla + bit de tecla pressionada
580   03B0              isys_wait_keyrelease
581   03B0 CD C2 04         CALL isys_keyb_disp         ; Exibe display e lê teclado
582   03B3 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Lê a memória de tecla lida
583   03B6 CB 7F            BIT 7,A
584   03B8 C8               RET Z                       ; Verifica se alguma tecla foi pressionada (digitação de um endereço, p. ex.)
585   03B9 18 F5            JR isys_wait_keyrelease     ; Fica em loop até uma tecla ser pressionada
586   03BB 00               DB 00H
587   03BC
588   03BC              ; Subrotina de entrada de valor no campo de dados (isys_in_data)
589   03BC              ; O software fica preso nessa rotina até que uma tecla de 10 a 17 seja pressionada
590   03BC              ; HL: Definição da primeira área de memória para uso com a entrada de dados (2 dígitos)
591   03BC              ; Teclas de 0 a F = serão reproduzidas no display e atualizam o valor em (HL)
592   03BC              ; Teclas de 10 a 17 = encerram o loop da subrotina, tecla pressionada em RAM_KEYB_CONV
593   03BC              ;       If !(keypress.bit7) then RST keyprsmem.bit7
594   03BC              ;       If  (keypress.bit7) &&  (keyprsmem.bit7) then end
595   03BC              ;       If  (keypress.bit7) && !(keyprsmem.bit7) then SET keyprsmem.bit7 and process the input
596   03BC              isys_in_data:
597   03BC C5               PUSH BC                     ; Guarda na pilha valor atual de BC para poder usar BC na subrotina
598   03BD 3E FF            LD A,0FFH
599   03BF 32 74 27         LD (RAM_DISPLAY+4),A        ; Limpa memória de exibição do 5.o display de endereçamento
600   03C2 32 75 27         LD (RAM_DISPLAY+5),A        ; Limpa memória de exibição do 6.o display de endereçamento
601   03C5 3E 00            LD A,00H
602   03C7 32 68 27         LD (RAM_DRAFT1),A
603   03CA              .in_data_input_loop:
604   03CA CD C2 04         CALL isys_keyb_disp         ; Chama atualização do display e teclado
605   03CD 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Recupera tecla atualmente pressionada (keypress = RAM_KEYB_CONV)
606   03D0 CB 7F            BIT 7,A                     ; Testa bit 7 de RAM_KEYB_CONV para verificar se alguma tecla está pressionada (keypress.bit7)
607   03D2 28 2B            JR Z,.in_data_rst_keyprsmem ; Bit 7 keypress é zero (tecla solta): reseta bit 7 memória (keypressmem)
608   03D4 3A 68 27         LD A,(RAM_DRAFT1)           ; Recupera memória de tecla pressionada (keyprsmem)
609   03D7 CB 7F            BIT 7,A                     ; Testa bit 7, sinalizador de tecla pressionada anteriormente (keyprsmem.bit7)
610   03D9 20 EF            JR NZ,.in_data_input_loop   ; bit 7 memória não zero (setado): não faz nada, finaliza a subrotina
611   03DB CB FF            SET 7,A                     ; Seta bit 7 e segue com o processamento da tecla pressionada
612   03DD 32 68 27         LD (RAM_DRAFT1),A           ; Salva na memória de tecla pressionada (keyprsmem), que há uma tecla pressionada (bit 7 setado)
613   03E0 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Recupera tecla atualmente pressionada (keypress = RAM_KEYB_CONV)
614   03E3 CB BF            RES 7,A                     ; Reseta o bit 7 no registrador A para testar se a tecla é numérica ou de função
615   03E5 FE 10            CP 10H                      ; Compara o código da tecla com 10H (16)
616   03E7 38 02            JR C,.in_data_num_key       ; Se for menor que 16, a tecla é numérica, segue para o processamento da entrada numérica
617   03E9 18 1E            JR .in_data_end             ; Se for maior ou igual a 16, a tecla é de função, encerra o loop de entrada numérica
618   03EB              .in_data_num_key:
619   03EB CD 7B 04         CALL isys_conv_hexdisp      ; Converte o código da tecla hex (= A) em código de exibição correspondente no display -> C
620   03EE CD A8 04         CALL isys_sftl_data_disp    ; Desloca no display 1 dígito para esquerda e acrescenta novo dígito contido em C
621   03F1                                              ; Atualização do valor na variável apontada por HL, suponha dado 8 bits = "XY"
622   03F1 4F               LD C,A                      ; Guarda o valor digitado em C para poder usar o A, suponha valor digitado = "0K"
623   03F2 7E               LD A,(HL)                   ; Lê o dado da parte menos significativa -> A = "XY"
624   03F3 CB 27            SLA A                       ; Desloca parte menos significativa para esquerda -> A = "Y0"
625   03F5 CB 27            SLA A
626   03F7 CB 27            SLA A
627   03F9 CB 27            SLA A
628   03FB B1               OR C                        ; Combina valor digitado com valor deslocado -> "Y0" OR "0K" = "YK"
629   03FC 77               LD (HL),A                   ; Guarda valor combinado na parte menos significativa. Resultado final = "YK"
630   03FD 18 CB            JR .in_data_input_loop      ; Retorna ao inicio da subrotina de entrada para testar se há próximo digito de entrada
631   03FF              .in_data_rst_keyprsmem:
632   03FF 3A 68 27         LD A,(RAM_DRAFT1)           ; HL contém a posição de memória da variável de sistema
633   0402 CB BF            RES 7,A                     ; Reseta o bit 7, sinalizador de tecla pressionada anteriormente
634   0404 32 68 27         LD (RAM_DRAFT1),A           ; Grava de volta na memória de sinalização de tecla pressionada anteriormente
635   0407 18 C1            JR .in_data_input_loop      ; Retorna ao inicio da subrotina de entrada para testar se há próximo digito de entrada
636   0409              .in_data_end:
637   0409 C1               POP BC                      ; Recupera registrador BC
638   040A C9               RET
639   040B 00               DB 00H
640   040C
641   040C              ; Subrotina de entrada de valor no campo de endereço (isys_in_addr)
642   040C              ; O software fica preso nessa rotina até que uma tecla de 10 a 17 seja pressionada
643   040C              ; HL: Definição da primeira área de memória para uso com a entrada de dados
644   040C              ;    (4 dígitos, sequencia little endian)
645   040C              ; Teclas de 0 a F = serão reproduzidas no display e atualizam o valor em (HL)
646   040C              ; Teclas de 10 a 17 = encerram o loop da subrotina, tecla pressionada em RAM_KEYB_CONV
647   040C              ;       If !(keypress.bit7) then RST keyprsmem.bit7
648   040C              ;       If  (keypress.bit7) &&  (keyprsmem.bit7) then end
649   040C              ;       If  (keypress.bit7) && !(keyprsmem.bit7) then SET keyprsmem.bit7 and process the input
650   040C              isys_in_addr:
651   040C C5               PUSH BC                     ; Guarda na pilha valor atual de BC para poder usar BC na subrotina
652   040D 3E FF            LD A,0FFH
653   040F 32 70 27         LD (RAM_DISPLAY),A          ; Limpa memória de exibição do 1.o display de endereçamento
654   0412 32 71 27         LD (RAM_DISPLAY+1),A        ; Limpa memória de exibição do 2.o display de endereçamento
655   0415 32 72 27         LD (RAM_DISPLAY+2),A        ; Limpa memória de exibição do 3.o display de endereçamento
656   0418 32 73 27         LD (RAM_DISPLAY+3),A        ; Limpa memória de exibição do 4.o display de endereçamento
657   041B              ;    CALL isys_clean_ram_disp   ; Limpa a memória de exibição no display
658   041B 3E 00            LD A,00H
659   041D 32 68 27         LD (RAM_DRAFT1),A
660   0420              .in_addr_input_loop:
661   0420 CD C2 04         CALL isys_keyb_disp         ; Chama atualização do display e teclado
662   0423 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Recupera tecla atualmente pressionada (keypress = RAM_KEYB_CONV)
663   0426 CB 7F            BIT 7,A                     ; Testa bit 7 de RAM_KEYB_CONV para verificar se alguma tecla está pressionada (keypress.bit7)
664   0428 28 44            JR Z,.in_addr_rst_keyprsmem ; Bit 7 keypress é zero (tecla solta): reseta bit 7 memória (keypressmem)
665   042A 3A 68 27         LD A,(RAM_DRAFT1)           ; Recupera memória de tecla pressionada (keyprsmem)
666   042D CB 7F            BIT 7,A                     ; Testa bit 7, sinalizador de tecla pressionada anteriormente (keyprsmem.bit7)
667   042F 20 EF            JR NZ,.in_addr_input_loop   ; bit 7 memória não zero (setado): não faz nada, finaliza a subrotina
668   0431 CB FF            SET 7,A                     ; Seta bit 7 e segue com o processamento da tecla pressionada
669   0433 32 68 27         LD (RAM_DRAFT1),A           ; Salva na memória de tecla pressionada (keyprsmem), que há uma tecla pressionada (bit 7 setado)
670   0436 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Recupera tecla atualmente pressionada (keypress = RAM_KEYB_CONV)
671   0439 CB BF            RES 7,A                     ; Reseta o bit 7 no registrador A para testar se a tecla é numérica ou de função
672   043B FE 10            CP 10H                      ; Compara o código da tecla com 10H (16)
673   043D 38 02            JR C,.in_addr_num_key       ; Se for menor que 16, a tecla é numérica, segue para o processamento da entrada numérica
674   043F 18 37            JR .in_addr_end             ; Se for maior ou igual a 16, a tecla é de função, encerra o loop de entrada numérica
675   0441              .in_addr_num_key:
676   0441 CD 7B 04         CALL isys_conv_hexdisp      ; Converte o código da tecla hex (= A) em código de exibição correspondente no display -> C
677   0444 CD 8E 04         CALL isys_sftl_addr_disp    ; Desloca no display 1 dígito para esquerda e acrescenta novo dígito contido em C
678   0447                                              ; Atualização do valor na variável apontada por HL, suponha dado 16 bits = "WX YZ"
679   0447 4F               LD C,A                      ; Guarda o valor digitado em C para poder usar o A, suponha valor digitado = "0K"
680   0448 23               INC HL                      ; Vai para a parte mais significativa dos 16 bits
681   0449 7E               LD A,(HL)                   ; Lê o dado da parte mais significativa -> "WX"
682   044A CB 27            SLA A                       ; Desloca parte mais significativa para esquerda -> "X0"
683   044C CB 27            SLA A
684   044E CB 27            SLA A
685   0450 CB 27            SLA A
686   0452 47               LD B,A                      ; Guarda valor deslocado em B -> B = "X0"
687   0453 2B               DEC HL                      ; Coloca ponteiro na parte menos significativa
688   0454 7E               LD A,(HL)                   ; Lê o dado da parte menos significativa -> A = "YZ"
689   0455 CB 3F            SRL A                       ; Desloca parte menos significativa para direita -> A = "0Y"
690   0457 CB 3F            SRL A
691   0459 CB 3F            SRL A
692   045B CB 3F            SRL A
693   045D B0               OR B                        ; Combina partes deslocadas A e B -> "X0" OR "0Y" = "XY"
694   045E 23               INC HL                      ; Coloca ponteiro na parte mais significativa
695   045F 77               LD (HL),A                   ; Guarda valor combinado na parte mais significativa -> (HL) = "XY"
696   0460 2B               DEC HL                      ; Coloca ponteiro na parte menos significativa
697   0461 7E               LD A,(HL)                   ; Lê o dado da parte menos significativa -> A = "YZ"
698   0462 CB 27            SLA A                       ; Desloca parte menos significativa para esquerda -> A = "Z0"
699   0464 CB 27            SLA A
700   0466 CB 27            SLA A
701   0468 CB 27            SLA A
702   046A B1               OR C                        ; Combina valor digitado com valor deslocado -> "Z0" OR "0K" = "ZK"
703   046B 77               LD (HL),A                   ; Guarda valor combinado na parte menos significativa. Resultado final = "XYZK"
704   046C 18 B2            JR .in_addr_input_loop      ; Retorna ao inicio da subrotina de entrada para testar se há próximo digito de entrada
705   046E              .in_addr_rst_keyprsmem:
706   046E 3A 68 27         LD A,(RAM_DRAFT1)           ; HL contém a posição de memória da variável de sistema
707   0471 CB BF            RES 7,A                     ; Reseta o bit 7, sinalizador de tecla pressionada anteriormente
708   0473 32 68 27         LD (RAM_DRAFT1),A           ; Grava de volta na memória de sinalização de tecla pressionada anteriormente
709   0476 18 A8            JR .in_addr_input_loop      ; Retorna ao inicio da subrotina de entrada para testar se há próximo digito de entrada
710   0478              .in_addr_end:
711   0478 C1               POP BC                      ; Recupera registrador BC
712   0479 C9               RET
713   047A 00               DB 00H
714   047B
715   047B              ; Subrotina que converte um digito hexadecimal para exibição no display (_conv_hexdisp)
716   047B              ; A = num. hexadecimal 1 dígito
717   047B              ; C = retorna o valor para exibição no display
718   047B              isys_conv_hexdisp:
719   047B F5               PUSH AF
720   047C C5               PUSH BC
721   047D E5               PUSH HL
722   047E E6 0F            AND 0FH                     ; Isola o nibble menos significativo do código da tecla
723   0480 4F               LD C,A
724   0481 06 00            LD B,00H
725   0483 21 76 05         LD HL,DB_NUMCHAR
726   0486 09               ADD HL,BC
727   0487 7E               LD A,(HL)
728   0488 E1               POP HL
729   0489 C1               POP BC
730   048A 4F               LD C,A
731   048B F1               POP AF
732   048C C9               RET
733   048D 00               DB 00H
734   048E
735   048E              ; Sub-subrotina de deslocamento da memória do display de endereço (RAM_DISPLAY) em 1 dígito para esquerda
736   048E              ; C = valor a ser inserido
737   048E              isys_sftl_addr_disp:
738   048E E5               PUSH HL
739   048F D5               PUSH DE
740   0490 C5               PUSH BC
741   0491 21 70 27         LD HL,RAM_DISPLAY
742   0494 54               LD D,H
743   0495 5D               LD E,L
744   0496 23               INC HL
745   0497 0E 03            LD C,03
746   0499 06 00            LD B,00
747   049B ED B0            LDIR
748   049D 13               INC DE
749   049E C1               POP BC
750   049F F5               PUSH AF
751   04A0 2B               DEC HL
752   04A1 79               LD A,C
753   04A2 77               LD (HL),A
754   04A3 F1               POP AF
755   04A4 D1               POP DE
756   04A5 E1               POP HL
757   04A6 C9               RET
758   04A7 00               DB 00H
759   04A8
760   04A8              ; Sub-subrotina de deslocamento da memória do display de dados (RAM_DISPLAY+4) em 1 dígito para esquerda
761   04A8              ; C = valor a ser inserido
762   04A8              isys_sftl_data_disp:
763   04A8 E5               PUSH HL
764   04A9 D5               PUSH DE
765   04AA C5               PUSH BC
766   04AB 21 74 27         LD HL,RAM_DISPLAY+4
767   04AE 54               LD D,H
768   04AF 5D               LD E,L
769   04B0 23               INC HL
770   04B1 0E 01            LD C,01
771   04B3 06 00            LD B,00
772   04B5 ED B0            LDIR
773   04B7 13               INC DE
774   04B8 C1               POP BC
775   04B9 F5               PUSH AF
776   04BA 2B               DEC HL
777   04BB 79               LD A,C
778   04BC 77               LD (HL),A
779   04BD F1               POP AF
780   04BE D1               POP DE
781   04BF E1               POP HL
782   04C0 C9               RET
783   04C1 00               DB 00H
784   04C2
785   04C2              ; Subrotina de atualização do display/teclado (isys_keyb_disp)
786   04C2              ; Dados relevantes
787   04C2              ; (RAM_DISPLAY) = Inicio da sequencia das 6 posições de memória lidas pelo sistema para exibição no display
788   04C2              ;                 Dado gravado nas posições de memória são o estado de cada segmento do display
789   04C2              ; (RAM_KEYB_CONV) = Posição de memória onde é armazenado o código da tecla apertada e se há uma tecla apertada
790   04C2              ;                   Bits (1 byte):  P X X X K K K K
791   04C2              ;                   P: Se 1, alguma tecla pressionada; Se 0, nenhuma tecla pressionada
792   04C2              ;                   X: "Don't care" (sem função)
793   04C2              ;                   KKKK: 1 nibble do código de tecla cf. abaixo:
794   04C2              ;                   0 a 9H: Teclas "0" a "9" pressionadas (com o bit P)
795   04C2              ;                   A a FH: Teclas "A" a "F" pressionadas (com o bit P)
796   04C2              ;                   10H: Tecla "ADR"
797   04C2              ;                   11H: Tecla "DAT"
798   04C2              ;                   12H: Tecla "-"
799   04C2              ;                   13H: Tecla "+"
800   04C2              ;                   14H: Tecla "GO"
801   04C2              ;                   15H: Tecla "REG"
802   04C2              ;                   16H: Tecla "IV"
803   04C2              ;                   17H: Tecla Vazia
804   04C2              isys_keyb_disp:
805   04C2 C5               PUSH BC
806   04C3 E5               PUSH HL
807   04C4 3E 00            LD A,00
808   04C6 32 6D 27         LD (RAM_KEYB_CONV),A        ; Limpa variável de memória do teclado antes de ler o teclado
809   04C9 3E 01            LD A,01H                    ; Ajusta A para apontar para a primeira coluna de displays (mais significativa)
810   04CB 21 70 27         LD HL,RAM_DISPLAY           ; Carrega no ponteiro HL primeiro endereço da RAM de sistema para o display
811   04CE              .keyb_disp_loop:
812   04CE D3 03            OUT (SEL_DISP),A            ; Seleciona display apontado por A
813   04D0 4F               LD C,A                      ; Guarda o valor de A
814   04D1 3E FF            LD A,0FFH
815   04D3 D3 01            OUT (DISP),A
816   04D5                  ;LD B, 1
817   04D5                  ;CALL isys_delay_ms
818   04D5 DB 01            IN A,(KEYB)                 ; Lê o teclado na coluna atual
819   04D7 FE 00            CP 00
820   04D9 28 7B            JR Z,.wr_display            ; Se nada foi lido do teclado (nenhuma tecla apertada), vai para a atualização do display direto
821   04DB 32 6E 27         LD (RAM_KEYBOARD),A         ; Se algo foi lido do teclado, registra tecla para a coluna atual
822   04DE 79               LD A,C                      ; Recupera dado de qual coluna está sendo atualizada
823   04DF 32 6F 27         LD (RAM_KEYB_COL),A         ; Registra na memória de qual coluna é a tecla apertada
824   04E2              .keyb_disp_cnv:
825   04E2 3A 6E 27         LD A,(RAM_KEYBOARD)         ; Converte posição da tecla no valor correspondente que representa (função da tecla)
826   04E5 FE 01            CP 01                       ; Não foi considerada ainda a coluna nesse ponto
827   04E7 CA 0F 05         JP Z,.keyb_disp_num_0
828   04EA FE 02            CP 02
829   04EC CA 14 05         JP Z,.keyb_disp_num_1
830   04EF FE 04            CP 04
831   04F1 CA 19 05         JP Z,.keyb_disp_num_2
832   04F4 FE 08            CP 08
833   04F6 CA 1E 05         JP Z,.keyb_disp_num_3
834   04F9 FE 10            CP 16
835   04FB CA 23 05         JP Z,.keyb_disp_num_4
836   04FE FE 20            CP 32
837   0500 CA 28 05         JP Z,.keyb_disp_num_5
838   0503 FE 40            CP 64
839   0505 CA 2D 05         JP Z,.keyb_disp_num_6
840   0508 FE 80            CP 128
841   050A CA 32 05         JP Z,.keyb_disp_num_7
842   050D 18 47            JR .wr_display
843   050F              .keyb_disp_num_0:
844   050F 3E 00            LD A,00H
845   0511 47               LD B,A
846   0512 18 21            JR .keyb_col
847   0514              .keyb_disp_num_1:
848   0514 3E 01            LD A,01H
849   0516 47               LD B,A
850   0517 18 1C            JR .keyb_col
851   0519              .keyb_disp_num_2:
852   0519 3E 02            LD A,02H
853   051B 47               LD B,A
854   051C 18 17            JR .keyb_col
855   051E              .keyb_disp_num_3:
856   051E 3E 03            LD A,03H
857   0520 47               LD B,A
858   0521 18 12            JR .keyb_col
859   0523              .keyb_disp_num_4:
860   0523 3E 04            LD A,04H
861   0525 47               LD B,A
862   0526 18 0D            JR .keyb_col
863   0528              .keyb_disp_num_5:
864   0528 3E 05            LD A,05H
865   052A 47               LD B,A
866   052B 18 08            JR .keyb_col
867   052D              .keyb_disp_num_6:
868   052D 3E 06            LD A,06H
869   052F 47               LD B,A
870   0530 18 03            JR .keyb_col
871   0532              .keyb_disp_num_7:
872   0532 3E 07            LD A,07H
873   0534 47               LD B,A
874   0535              .keyb_col:
875   0535 3A 6F 27         LD A,(RAM_KEYB_COL)         ; Decodifica a coluna e calcula o código correto da tecla (0~7H: coluna 1, 8~FH: coluna 2; 10~17H: coluna 3)
876   0538 FE 01            CP 01
877   053A 28 0A            JR Z,.keyb_cnv_plus0
878   053C FE 02            CP 02
879   053E 28 09            JR Z,.keyb_cnv_plus8
880   0540 FE 04            CP 04
881   0542 28 0A            JR Z,.keyb_cnv_plus16
882   0544 18 10            JR .wr_display
883   0546              .keyb_cnv_plus0:                ; Identificado como tecla da coluna 1 (0~7H)
884   0546 78               LD A,B
885   0547 18 08            JR .keyb_cnv_end
886   0549              .keyb_cnv_plus8:                ; Identificado como tecla da coluna 2 (8~FH)
887   0549 78               LD A,B
888   054A C6 08            ADD A,08
889   054C 18 03            JR .keyb_cnv_end
890   054E              .keyb_cnv_plus16:               ; Identificado como tecla da coluna 1 (10~17H)
891   054E 78               LD A,B
892   054F C6 10            ADD A,16
893   0551              .keyb_cnv_end:
894   0551 CB FF            SET 7,A                     ; Seta o bit 7 do valor convertido para dizer que a tecla foi pressionada, especialmente no caso do zero (0H)
895   0553 32 6D 27         LD (RAM_KEYB_CONV),A
896   0556              .wr_display:
897   0556 7E               LD A,(HL)
898   0557 D3 01            OUT (DISP),A
899   0559 06 02            LD B, 2
900   055B CD 6A 05         CALL isys_delay_ms
901   055E 23               INC HL
902   055F 79               LD A,C
903   0560 87               ADD A,A
904   0561 FE 40            CP 64
905   0563 C2 CE 04         JP NZ, .keyb_disp_loop      ; Se não chegou na última coluna de atualização do display (64), vai para o próximo loop
906   0566 E1               POP HL
907   0567 C1               POP BC
908   0568 C9               RET
909   0569 00               DB 00H
910   056A
911   056A              ; Delay (operativo, ms) para clk = 2 MHz (isys_delay_ms);
912   056A              ; Entrada: B = delay (ms) 0,5% ;
913   056A              ; Afeta registradores A, B, F
914   056A              isys_delay_ms:
915   056A F5               PUSH AF
916   056B              .delay_mult:
917   056B 78               LD A,B
918   056C 06 98            LD B, 152                   ; Numero de loops ajustados para A = delay "ms" com mínimo erro
919   056E              .delay_1ms:
920   056E 10 FE            DJNZ .delay_1ms
921   0570 47               LD B,A
922   0571 10 F8            DJNZ .delay_mult
923   0573 F1               POP AF
924   0574 C9               RET
925   0575 00               DB 00H
926   0576
927   0576              ; Código dos caracteres para exibição no display em sequencia de endereços para facilitar a conversão numérica
928   0576              DB_NUMCHAR EQU $
929   0576 C0               DB      0C0H                ; Caractere 0
930   0577 F9               DB      0F9H                ; Caractere 1
931   0578 A4               DB      0A4H                ; Caractere 2
932   0579 B0               DB      0B0H                ; Caractere 3
933   057A 99               DB      099H                ; Caractere 4
934   057B 92               DB      092H                ; Caractere 5
935   057C 82               DB      082H                ; Caractere 6
936   057D F8               DB      0F8H                ; Caractere 7
937   057E 80               DB      080H                ; Caractere 8
938   057F 90               DB      090H                ; Caractere 9
939   0580 88               DB      088H                ; Caractere A
940   0581 83               DB      083H                ; Caractere B
941   0582 C6               DB      0C6H                ; Caractere C
942   0583 A1               DB      0A1H                ; Caractere D
943   0584 86               DB      086H                ; Caractere E
944   0585 8E               DB      08EH                ; Caractere F
945   0586 FF               DB      0FFH                ; Tecla especial 1
946   0587 FF               DB      0FFH                ; Tecla especial 2
947   0588 FF               DB      0FFH                ; Tecla especial 3
948   0589 FF               DB      0FFH                ; Tecla especial 4
949   058A FF               DB      0FFH                ; Tecla especial 5
950   058B FF               DB      0FFH                ; Tecla especial 6
951   058C FF               DB      0FFH                ; Tecla especial 7
952   058D FF               DB      0FFH                ; Tecla especial 8
953   058E
954   058E              itest_prog:                     ; Rotina do programa de teste do NEMO-80
955   058E 3E 00            LD A,00H
956   0590 32 FC 25         LD (VAR_TEST),A
957   0593 CD 54 03         CALL isys_clean_ram_disp
958   0596 CD C2 04         CALL isys_keyb_disp
959   0599              loop_test_inc:
960   0599 3A FC 25         LD A,(VAR_TEST)
961   059C 3C               INC A
962   059D 32 FC 25         LD (VAR_TEST),A
963   05A0 21 FC 25         LD HL,VAR_TEST
964   05A3 06 14            LD B,20
965   05A5              loop_test_disp:
966   05A5 CD 64 03         CALL isys_disp_data
967   05A8 10 FB            DJNZ loop_test_disp
968   05AA 18 ED            JR loop_test_inc
969   05AC 76               HALT
970   05AD 00               DB 00H

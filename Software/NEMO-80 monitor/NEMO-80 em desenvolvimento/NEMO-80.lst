339   0221 C3 92 02         JP .imenu_reg_dispin16      ; Salta para rotina de exibição ou alteração do valor do registrador
340   0224              .imenu_reg_dispin:              ; Exibição ou alteração de registradores de 8 bits
341   0224 79               LD A,C                      ; Carrega em A o código do caractere a ser exibido nos displays de endereços
342   0225 32 72 27         LD (RAM_DISPLAY+2),A        ; Escreve na área de memória dos displays de endereços o valor de A
343   0228 CD 64 03         CALL isys_disp_data         ; Chama a sub-rotina de exibição de dados nos displays de dados (dado apontado na memória por HL)
344   022B 3A 6D 27         LD A,(RAM_KEYB_CONV)        ; Atualiza a exibição do display e leitura do teclado
345   022E CB 7F            BIT 7,A                     ; Testa se alguma tecla foi pressionada (bit 7 = ON, tecla foi pressionada)
346   0230 28 F2            JR Z,.imenu_reg_dispin      ; Loop para rotina de exibição ou alteração do valor do registrador
347   0232 CB BF            RES 7,A                     ; Retira (zera) o bit de tecla pressionada
348   0234              .imenu_reg_numkey:
349   0234 FE 0F            CP 0FH                      ; Verifica (pelo JR C abaixo) se a tecla pressionada é numérica, código da tecla =< 0FH
350   0236 38 02            JR C,.imenu_reg_indata      ; Pressionada tecla de valor numérico indicando alteração de valor do registrador
351   0238 18 0C            JR .imenu_reg_minus         ; Não sendo tecla numérica, verifica se não é a tecla "-"
352   023A              .imenu_reg_indata:              ; Ponto de entrada de tratamento de entrada numérica (tecla numérica foi apertada)
353   023A CD B0 03         CALL isys_wait_keyrelease   ; Aguarda usuário soltar a tecla
354   023D CD BC 03         CALL isys_in_data           ; Executa sub-rotina de entrada numérica para alteração do valor do registrador
355   0240 3A 69 27         LD A,(RAM_DRAFT2)           ; Recupera valor de onde, no menu de registradores, parou a sequencia de exibição de registradores
356   0243 C3 74 01         JP .imenu_reg_a             ; Volta para ponto de entrada de exibição dos registradores nos displays
357   0246              .imenu_reg_minus:
358   0246 FE 12            CP KEY_MINUS                ; Verifica (escapa do JR NZ abaixo) se a tecla pressionada é tecla "-", código da tecla = 12H
359   0248 20 11            JR NZ,.imenu_reg_plus       ; Não sendo tecla "-", verifica se não é a tecla "+"
360   024A 3A 69 27         LD A,(RAM_DRAFT2)           ; Recupera valor de onde, no menu de registradores, parou a sequencia de exibição de registradores
361   024D FE 00            CP 00H                      ; Verifica se já está no primeiro item do menu de registradores (índice 0)
362   024F 28 04            JR Z,.imenu_reg_nodec       ; Se já estiver no índice 0, não decrementa.
363   0251 3D               DEC A                       ; Se não estiver no índice 0, decrementa o índice de exibição do menu de registradores
364   0252 32 69 27         LD (RAM_DRAFT2),A           ; Salva o índice decrementado em RAM_DRAFT2
365   0255              .imenu_reg_nodec:
366   0255 CD B0 03         CALL isys_wait_keyrelease   ; Em caso de não decrementar por estar no índice 0, aguarda soltar a tecla
367   0258 C3 74 01         JP .imenu_reg_a             ; Retorna para o menu de registradores, sem alterar o índice
368   025B              .imenu_reg_plus:
369   025B FE 13            CP KEY_PLUS                 ; Verifica (escapa do JR NZ abaixo) se a tecla pressionada é tecla "+", código da tecla = 12H
370   025D 20 12            JR NZ,.imenu_reg_otherkey   ; Não sendo tecla "+", é outra tecla, então os registradores são atualizados com os valores de memória e o menu encerrado
371   025F 3A 69 27         LD A,(RAM_DRAFT2)           ; Recupera valor de onde, no menu de registradores, parou a sequencia de exibição de registradores
372   0262 FE 0A            CP 0AH                      ; Verifica se já está no último item do menu de registradores (índice 10 (=0AH))
373   0264 CA 6B 02         JP Z,.imenu_reg_noinc       ; Se já estiver no índice 10, não incrementa.
374   0267 3C               INC A                       ; Se não estiver no índice 10, incrementa o índice de exibição do menu de registradores
375   0268 32 69 27         LD (RAM_DRAFT2),A           ; Salva o índice decrementado em RAM_DRAFT2
376   026B              .imenu_reg_noinc:
377   026B CD B0 03         CALL isys_wait_keyrelease   ; Em caso de não incrementar por estar no índice 10, aguarda soltar a tecla
378   026E C3 74 01         JP .imenu_reg_a             ; Retorna para o menu de registradores, sem alterar o índice
379   0271              .imenu_reg_otherkey:            ; Ao finalizar a rotina dos registradores, transfere os valores manipulados na memória para registradore
